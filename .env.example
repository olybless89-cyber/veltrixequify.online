APP_NAME="Veltrix Equify"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://veltrixequify.online
APP_TIMEZONE="UTC"

LOG_CHANNEL=stack
LOG_LEVEL=error

# ─── Database (Railway MySQL Plugin auto-injects these) ───────────────────────
# When using Railway MySQL plugin, these are auto-injected:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# The entrypoint script maps them to DB_* vars automatically.
# You can also set them manually here:
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST:-127.0.0.1}
DB_PORT=${MYSQLPORT:-3306}
DB_DATABASE=${MYSQLDATABASE:-veltrix}
DB_USERNAME=${MYSQLUSER:-veltrix}
DB_PASSWORD=${MYSQLPASSWORD:-}

# ─── Default Admin (Auto-created on first boot) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@veltrixequify.online
ADMIN_PASSWORD=Admin@2024!

# ─── Cache / Session / Queue ──────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Resend Email (Just add your API key) ─────────────────────────────────────
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@veltrixequify.online
MAIL_FROM_NAME="Veltrix Equify"

# ─── Optional Integrations ────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=
